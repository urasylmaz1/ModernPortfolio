@model AboutSkillsViewModel
@{
    ViewData["Title"] = "Hakkımda";
}
<!-- About Section -->
    <section id="about" class="about section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Hakkımda</h2>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4 justify-content-center">
          <div class="col-lg-4">
            <img src="@Model.About?.ImageUrl" class="img-fluid" alt="">
          </div>
          <div class="col-lg-8 content">
            <h2>@Model.About?.Title</h2>
            <p class="fst-italic py-3">
              @Model.About?.Description
            </p>
            <div class="row">
              <div class="col-lg-6">
                <ul>
                  <li><i class="bi bi-chevron-right"></i> <strong>Yaş:</strong> <span>@Model.About?.Age</span></li>
                  <li><i class="bi bi-chevron-right"></i> <strong>Şehir:</strong> <span>@Model.About?.City</span></li>
                  <li><i class="bi bi-chevron-right"></i> <strong>Telefon:</strong> <span>@Model.About?.PhoneNumber</span></li>
                  
                </ul>
              </div>
              <div class="col-lg-6">
                <ul>
                  <li><i class="bi bi-chevron-right"></i> <strong>Email:</strong> <a href="mailto:@Model.About?.Email">@Model.About?.Email</a></li>
                  <li><i class="bi bi-chevron-right"></i> <strong>Github:</strong> <a href="@Model.About?.GithubUrl" target="_blank">@Model.About?.GithubUrl</a></li>
                  <li><i class="bi bi-chevron-right"></i> <strong>LinkedIn:</strong> <a href="@Model.About?.LinkedinUrl" target="_blank">@Model.About?.LinkedinUrl</a></li>
                </ul>
              </div>
            </div>
            <p class="py-3">
            </p>
          </div>
        </div>

      </div>

    </section><!-- /About Section -->

<!-- Skills Section -->
    <section id="skills" class="skills section">

      <!-- Section Title -->
      <div class="container section-title" data-aos="fade-up">
        <h2>Yetenekler</h2>
      </div><!-- End Section Title -->

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row skills-content skills-animation">
          
          @{
            int rightCount = Model.Skills.Count() / 2;
            int leftCount = Model.Skills.Count() - rightCount;
          }
          @for (int i = 0; i < leftCount; i++)
          {
              var skill = Model.Skills[i];
              <div class="col-lg-6">
                  <div class="progress">
                      <span class="skill"><span>@skill.Name</span> <i class="val">@skill.Percentage%</i></span>
                      <div class="progress-bar-wrap">
                          <div class="progress-bar" role="progressbar" aria-valuenow="@skill.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                  </div><!-- End Skills Item -->
              </div>
          }
          @for (int i = leftCount; i < Model.Skills.Count(); i++)
          {
              var skill = Model.Skills[i];
              <div class="col-lg-6">
                  <div class="progress">
                      <span class="skill"><span>@skill.Name</span> <i class="val">@skill.Percentage%</i></span>
                      <div class="progress-bar-wrap">
                          <div class="progress-bar" role="progressbar" aria-valuenow="@skill.Percentage" aria-valuemin="0" aria-valuemax="100"></div>
                      </div>
                  </div><!-- End Skills Item -->
              </div>
          }
        </div>

      </div>

    </section><!-- /Skills Section -->