@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}
<!-- Sign In Start -->
        <div class="container-fluid">
            <div class="row h-100 align-items-center justify-content-center" style="min-height: 100vh;">
                <div class="col-12 col-sm-8 col-md-6 col-lg-5 col-xl-4">
                    <div class="bg-light rounded p-4 p-sm-5 my-4 mx-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <a href="index.html" class="">
                                <h3 class="text-primary"><i class="fa fa-hashtag me-2"></i>Yönetim Paneli</h3>
                            </a>
                            <h3>Giriş Yap</h3>
                        </div>
                        <form asp-controller="Account" asp-action="Login" method="post">
                            <asp-validation-summary="All" class="text-danger mb-3"/>
                            <div class="form-floating mb-3">
                                <input asp-for="UserName"class="form-control" placeholder="Kullanıcı Adı" />
                                <label asp-for="UserName"> </label>
                            </div>
                            <div class="form-floating mb-4">
                                <input asp-for="Password" class="form-control"  placeholder="Password">
                                <label asp-for="Password"> </label>
                            </div>
                            <div class="d-flex align-items-center justify-content-between mb-4">
                                <div class="form-check">
                                    <input  class="form-check-input" asp-for="RememberMe">
                                    <label class="form-check-label"  asp-for="RememberMe"></label>
                                </div>
                                <a href="">Forgot Password</a>
                            </div>
                            <button type="submit" class="btn btn-primary py-3 w-100 mb-4">Giriş Yap</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
        <!-- Sign In End -->