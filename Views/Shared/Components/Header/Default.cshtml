@model AboutViewModel
@using ModernPortfolio.Extentions
<header id="header" class="header d-flex align-items-center light-background sticky-top">
    <div class="container-fluid position-relative d-flex align-items-center justify-content-between">

      <a href="/" class="logo d-flex align-items-center me-auto me-xl-0">
        <!-- Uncomment the line below if you also wish to use an image logo -->
        <!-- <img src="~/ui/img/logo.png" alt=""> -->
        <h1 class="sitename">@Model.Title</h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="~/" class="@Html.IsActive("Home", "Index")">Ana Sayfa</a></li>
          <li><a asp-controller="Home" asp-action="About" class="@Html.IsActive("Home", "About")">Hakkımda</a></li>
          <li><a asp-controller="Projects" asp-action="Index"class="@Html.IsActive("Projects", "Index")">Projeler</a></li>
          <li><a asp-controller="Home" asp-action="Contact" class="@Html.IsActive("Home", "Contact")">İletişim</a></li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

      <div class="header-social-links">
        <a href="@Model.GithubUrl" target="_blank" class="github"><i class="bi bi-github"></i></a>
        <a href="@Model.LinkedinUrl" target="_blank" class="linkedin"><i class="bi bi-linkedin"></i></a>
      </div>

    </div>
  </header>
