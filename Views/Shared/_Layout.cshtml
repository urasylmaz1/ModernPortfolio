<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>@ViewData[index: "Title"] - Modern Portfolio</title>
  <meta name="description" content="Modern Portfolio - Profesyonel Yazilim Gelistirici">
  <meta name="keywords" content="portfolio, yazilim, gelistirici, web, asp.net">
  <meta name= "author" content="Uras Yilmaz" />

  <!-- Favicons -->
  <link href="~/ui/img/favicon.png" rel="icon">
  <link href="~/ui/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Fonts -->
  <link href="https://fonts.googleapis.com" rel="preconnect">
  <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="~/ui/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="~/ui/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="~/ui/vendor/aos/aos.css" rel="stylesheet">
  <link href="~/ui/vendor/swiper/swiper-bundle.min.css" rel="stylesheet">
  <link href="~/ui/vendor/glightbox/css/glightbox.min.css" rel="stylesheet">

  <!-- Main CSS File -->
  <link href="~/ui/css/main.css" rel="stylesheet">

</head>

<body class="index-page">

  <header id="header" class="header d-flex align-items-center light-background sticky-top">
    <div class="container-fluid position-relative d-flex align-items-center justify-content-between">

      <a href="index.html" class="logo d-flex align-items-center me-auto me-xl-0">
        <!-- Uncomment the line below if you also wish to use an image logo -->
        <!-- <img src="~/ui/img/logo.png" alt=""> -->
        <h1 class="sitename">Kelly Adams</h1>
      </a>

      <nav id="navmenu" class="navmenu">
        <ul>
          <li><a href="~/" class="active">Ana Sayfa</a></li>
          <li><a asp-controller="Home" asp-action="About">Hakkımda</a></li>
          <li><a asp-controller="Projects" asp-action="Index">Projeler</a></li>
          <li><a asp-controller="Home" asp-action="Contact">İletişim</a></li>
        </ul>
        <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
      </nav>

      <div class="header-social-links">
        <a href="https://linkedin.com/in/uras-yılmaz-20108a26b" class="linkedin"><i class="bi bi-linkedin"></i></a>
      </div>

    </div>
  </header>

  <main class="main">

        @RenderBody()

  </main>

  <footer id="footer" class="footer light-background">

    <div class="container">
      <div class="copyright text-center ">
        <p>© <span>Tüm hakları saklıdır.</span> <strong class="px-1 sitename">Uras Yılmaz</strong> <span>tarafından yapılmıştır.<br></span></p>
      </div>
      <div class="social-links d-flex justify-content-center">
        <a href="https://linkedin.com/in/uras-yılmaz-20108a26b"><i class="bi bi-linkedin"></i></a>
      </div>
      <div class="credits">
        <!-- All the links in the footer should remain intact. -->
        <!-- You can delete the links only if you've purchased the pro version. -->
        <!-- Licensing information: https://bootstrapmade.com/license/ -->
        <!-- Purchase the pro version with working PHP/AJAX contact form: [buy-url] -->
        Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a> Distributed by <a href=“https://themewagon.com>ThemeWagon
      </div>
    </div>

  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <!-- Vendor JS Files -->
  <script src="~/ui/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="~/ui/vendor/php-email-form/validate.js"></script>
  <script src="~/ui/vendor/aos/aos.js"></script>
  <script src="~/ui/vendor/waypoints/noframework.waypoints.js"></script>
  <script src="~/ui/vendor/purecounter/purecounter_vanilla.js"></script>
  <script src="~/ui/vendor/swiper/swiper-bundle.min.js"></script>
  <script src="~/ui/vendor/glightbox/js/glightbox.min.js"></script>
  <script src="~/ui/vendor/imagesloaded/imagesloaded.pkgd.min.js"></script>
  <script src="~/ui/vendor/isotope-layout/isotope.pkgd.min.js"></script>

  <!-- Main JS File -->
  <script src="~/ui/js/main.js"></script>

</body>

</html>