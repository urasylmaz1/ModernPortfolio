@model List<SkillListViewModel>
@{
    ViewData["Title"] = "Yetenek Yönetimi";
}

<div class="container-fluid pt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Yetenek Yönetimi</h2>
        <a asp-area="Admin" asp-controller="Skills" asp-action="Create" class="btn btn-primary"> <i
                class="fas fa-plus"></i> Yeni Yetenek</a>
    </div>
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Yetenek</th>
                            <th scope="col">Yüzde</th>
                            <th scope="col">Sıra</th>
                            <th scope="col">Oluşturulma</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model is not null && Model.Any())
                        {
                            @foreach (var skill in Model)
                            {
                                <tr>
                                    <th scope="row">@skill.Id</th>
                                    <td>@skill.Name</td>
                                    <td>%@skill.Percentage</td>
                                    <td>@skill.DisplayOrder</td>
                                    <td>@skill.CreatedDate</td>
                                    <td>
                                        <a asp-area="Admin" asp-controller="Skills" asp-action="Edit" asp-route-id="@skill.Id"
                                            class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Düzenle
                                        </a>
                                        <form asp-area="Admin" asp-controller="Skills" asp-action="Delete"
                                            asp-route-id="@skill.Id" method="post" class="d-inline">

                                            <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('Bu yeteneği silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!');">

                                                <i class="fas fa-trash"></i>
                                                Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">Henüz yetenek eklenmemiş</div>
                        }

                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>