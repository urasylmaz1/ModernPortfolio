@model SkillEditViewModel
@{
    ViewData["Title"] = "Yetenek Güncelle";
}

<div class="container-fluid pt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Yetenek Güncelle</h2>
    </div>
    <div class="card">
        <div class="card-body">
            @if (TempData["SuccessMessage"] is not null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }


            <form asp-area="Admin" asp-controller="Skills" asp-action="Edit" method="post"
                enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for=Id />
                <div class="mb-3">
                    <label asp-for=Name class="form-label"></label>
                    <input asp-for=Name class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for=Percentage class="form-label"></label>
                    <input asp-for=Percentage class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for=DisplayOrder class="form-label"></label>
                    <input asp-for=DisplayOrder class="form-control" />
                </div>
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Güncelle
                    </button>
                    <a asp-area="Admin" asp-controller="Skills" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> İptal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}