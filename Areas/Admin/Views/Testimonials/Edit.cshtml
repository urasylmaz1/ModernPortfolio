@model TestimonialEditViewModel
@{
    ViewData["Title"] = "Yeni Yorum Ekle";
}

<div class="container-fluid pt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Referans Güncelle</h2>
    </div>
    <div class="card">
        <div class="card-body">
            @if (TempData["SuccessMessage"] is not null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] is not null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-area="Admin" asp-controller="Testimonials" asp-action="Edit" method="post"
                enctype="multipart/form-data">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for=Id />
                <div class="mb-3">
                    <label asp-for=ClientName class="form-label"></label>
                    <input asp-for=ClientName class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for=ClientPosition class="form-label"></label>
                    <input asp-for=ClientPosition class="form-control" />
                </div>
                <div class="mb-3">
                    <label asp-for=Comment class="form-label"></label>
                    <textarea asp-for=Comment class="form-control" rows="5"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for=Rating class="form-label"></label>
                    <input asp-for=Rating class="form-control" />
                </div>

                <div class="form-group">
                    <label asp-for=CurrentImageUrl class="form-label"></label>
                    @if (!string.IsNullOrEmpty(Model.CurrentImageUrl))
                    {
                        <div class="mb-2">
                            <img class="img-thumbnail" style="max-width=200px; max-height:200px;"
                                src="@Model.CurrentImageUrl" />
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Mevcut görsel yok</p>
                    }
                </div>

                <div class="mb-3">
                    <label asp-for=ImageFile class="form-label"></label>
                    <input asp-for=ImageFile class="form-control" accept="image/*" />
                    <small class="form-text text-muted">Desteklenen formatlar: JPG, PNG, GIF. Maksimum boyut:
                        5MB.</small>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for=IsActive class="form-check-input" />
                        <label asp-for=IsActive class="form-check-label"></label>
                    </div>
                </div>
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Güncelle
                    </button>
                    <a asp-area="Admin" asp-controller="Testimonials" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> İptal
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}