@model List<ProjectListViewModel>
@{
    ViewData["Title"] = "Proje Yönetimi";
}

<div class="container-fluid pt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Proje Yönetimi</h2>
        <a asp-area="Admin" asp-controller="Projects" asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Yeni Proje
        </a>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table">
                    <thead>
                        <tr>
                            <th scope="col">Id</th>
                            <th scope="col">Başlık</th>
                            <th scope="col">Görsel</th>
                            <th scope="col">Durum</th>
                            <th scope="col">Oluşturulma</th>
                            <th scope="col">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            @foreach (var project in Model)
                            {
                                <tr>
                                    <th scope="row">@project.Id</th>
                                    <td>@project.Title</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(project.ImageUrl))
                                        {
                                            <img src="@project.ImageUrl" alt="@project.Title" class="img-thumbnail" style="max-width: 100px; max: height 100px;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">Görsel yok</span>
                                        }
                                    </td>
                                    <td>@project.Status</td>
                                    <td>@project.CreatedDate</td>
                                    <td>
                                       <a asp-area="Admin" asp-controller="Projects" asp-action="Edit" asp-route-id="@project.Id" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i> Düzenle
                                       </a>
                                       <form asp-area="Admin" asp-controller="Projects" asp-action="Delete" asp-route-id="@project.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger" 
                                            onclick="return confirm('Bu projeyi silmek istediğinizden emin misiniz? Bu işlem geri alınamaz!');">
                                                <i class="fas fa-trash"></i> Sil</button>
                                       </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">Henüz proje eklenmemiş</div>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>