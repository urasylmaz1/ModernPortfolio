@model ProjectCreateViewModel
@{
    ViewData["Title"] = "Yeni Proje Ekle";
}
<div class="container-fluid pt-4 px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Yeni Proje Ekle</h2>
    </div>
    <div class="card-header">
        <h4>Yeni Proje Ekle</h4>
    </div>
    <div class="card-body">
        <form asp-area="Admin" asp-controller="Projects" asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="mb-3">
                    <label asp-for=Title class="form-label"></label>
                    <input asp-for=Title class="form-control"/>
                </div>
                <div class="mb-3">
                    <label asp-for=Description class="form-label"></label>
                    <textarea asp-for=Description class="form-control" rows="5"></textarea>
                </div>
                <div class="mb-3">
                    <label asp-for=ProjectUrl class="form-label"></label>
                    <input asp-for=ProjectUrl class="form-control"/>
                </div>
                <div class="mb-3">
                    <label asp-for=GithubUrl class="form-label"></label>
                    <input asp-for=GithubUrl class="form-control"/>
                </div>
                <div class="mb-3">
                    <label asp-for=ImageFile class="form-label"></label>
                    <input asp-for=ImageFile class="form-control" accept="image/*"/>
                    <small class="form-text text-muted">Desteklenen formatlar: JPG, PNG, GIF. Maksimum boyut: 5MB.</small>
                </div>
                <div class="mb-3">
                    <div class="form-check">
                        <input asp-for=IsActive class="form-check-input"/>
                        <label asp-for=IsActive class="form-check-label"></label>
                    </div>
                </div>
                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Kaydet
                    </button>
                    <a asp-area="Admin" asp-controller="Projects" asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-times"></i> İptal
                    </a>
                </div>
        </form>
    </div>
</div>

@section Scripts {
       @await Html.PartialAsync(partialViewName: "_ValidationScriptsPartial")
}