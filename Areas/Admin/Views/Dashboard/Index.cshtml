
@{
    ViewData["Title"] = "Dashboard Ana Sayfa";
}

<div class="container-fluid px-4 py-4">
    <div class="row">
        <div class="col-12">
            <div class="card border-0 shadow-sm rounded-4" style="background: linear-gradient(135deg, #f8fbff 0%, #eef4ff 100%); border: 1px solid rgba(0, 156, 255, 0.12) !important;">
                <div class="card-body p-4 p-lg-5">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <div>
                            <span class="badge rounded-pill bg-primary-subtle text-primary mb-3 px-3 py-2">Dashboard</span>
                            <h1 class="display-6 fw-bold mb-0 text-dark">Yönetim Paneline Hoş Geldiniz</h1>
                        </div>

                        <div class="text-end">
                            <div class="fw-semibold text-dark">Modern Portfolio</div>
                            <small class="text-muted">Kontrol merkezi</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>