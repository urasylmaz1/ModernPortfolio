<!-- Sidebar Start -->
<div class="sidebar pe-4 pb-3">
    <nav class="navbar bg-light navbar-light">
        <a href="/admin" class="navbar-brand mx-4 mb-3">
            <h3 class="text-primary"><i class="fa fa-hashtag me-2"></i>Yönetim Paneli</h3>
        </a>
        <div class="d-flex align-items-center ms-4 mb-4">
            <div>
                <h6 class="mb-0">@User.Identity!.Name</h6>
                <span>
                    @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                </span>
            </div>
        </div>
        @functions {
            string IsActive(string controller)
            {
                var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                return currentController == controller ? "active" : "";
            }
        }
        <div class="navbar-nav w-100">
            <a href="~/" target="_blank" class="nav-item nav-link"><i class="fa fa-tachometer-alt me-2"></i>Siteyi
                Aç</a>

            <a asp-area="Admin" asp-controller="Settings" asp-action="Index"
                class="nav-item nav-link @IsActive("Settings")"><i class="fa fa-laptop me-2"></i>Profil</a>
            <a asp-area="Admin" asp-controller="Projects" asp-action="Index"
                class="nav-item nav-link @IsActive("Projects")"><i class="fa fa-th me-2"></i>Projeler</a>
            <a asp-area="Admin" asp-controller="About" asp-action="Index"
                class="nav-item nav-link @IsActive("About")"><i class="fa fa-keyboard me-2"></i>Hakkımda</a>
            <a asp-area="Admin" asp-controller="Skills" asp-action="Index"
                class="nav-item nav-link @IsActive("Skills")"><i class="fa fa-table me-2"></i>Yetenekler</a>
            <a asp-area="Admin" asp-controller="Testimonials" asp-action="Index"
                class="nav-item nav-link @IsActive("Testimonials")"><i class="fa fa-chart-bar me-2"></i>Referanslar</a>

            <a asp-area="Admin" asp-controller="Account" asp-action="Logout" class="nav-item nav-link"><i
                    class="fa fa-th me-2"></i>Çıkış Yap</a>
        </div>
    </nav>
</div>
<!-- Sidebar End -->